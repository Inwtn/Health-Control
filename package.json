{
  "name": "health-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --mode portable",
    "build:web": "tsc -b && vite build",
    "build:portable": "tsc -b && vite build --mode portable",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:e2e": "npm run build:portable && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
